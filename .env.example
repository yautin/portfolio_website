# Supabase project credentials (Dashboard → Project Settings → API).
# The anon key is safe to expose client-side: row-level security policies
# restrict every request to the signed-in user's own rows.
# Copy this file to .env.local and fill in your values; set the same two
# variables in Vercel → Project → Settings → Environment Variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---- Web3 token-reward easter egg (all optional) ----
# When BOTH the token address and a functions URL are present, the /fun games
# offer a token reward after a win. Leave blank to hide the feature entirely
# (zero bundle cost — the wagmi/viem chunk is never fetched). Deploy the
# contract first (see contracts/README.md) to get the address. Safe to expose:
# these are public identifiers, and minting is admin-only + server-side.
VITE_REWARD_TOKEN_ADDRESS=
# Optional — defaults to ${VITE_SUPABASE_URL}/functions/v1 when blank.
VITE_REWARD_FUNCTIONS_URL=

# ---- Contact form (optional) ----
# Free access key from https://web3forms.com. The browser posts it directly, so
# it is unavoidably public — it lives here rather than in source so it can be
# rotated without a commit if it ever gets abused. In the Web3Forms dashboard,
# restrict the key to your domain. Leave blank and the contact form falls back
# to opening a pre-filled draft in the visitor's mail app.
VITE_WEB3FORMS_KEY=

# ---- Medical portfolio (server-only; NEVER prefix these with VITE_) ----
# Set a long, unique shared password. Leave blank to keep the portfolio locked.
PORTFOLIO_PASSWORD=
# Independent random signing secret, at least 32 characters.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
PORTFOLIO_SESSION_SECRET=
# Local/private filesystem storage: absolute path OUTSIDE this repository.
# Directory must contain catalog.json, allowlisted PDFs and WebP covers.
# This path does not upload assets to Vercel; see docs/medical-portfolio.md.
PORTFOLIO_ASSET_DIR=
# Supabase private storage (server-only; optional alternative to the local path).
# Leave ALL THREE variables UNSET for local filesystem mode. Even an empty or
# partial cloud setting fails closed; configured cloud storage NEVER falls back.
# Uncomment and supply all three for deployment. Use a private (not public)
# bucket containing catalog.json, <id>.pdf and <id>.webp at its root.
# PORTFOLIO_STORAGE_URL=https://your-project-ref.supabase.co
# PORTFOLIO_STORAGE_KEY=your-server-secret-or-service-role-key
# PORTFOLIO_STORAGE_BUCKET=medical-portfolio-private
# Use an sb_secret_ key or legacy service_role JWT, never an anon/publishable key.
# Never prefix these settings with VITE_ or expose them in client code/logs.
# Catalog and WebP covers are limited to 1 MiB each. PDFs use 60-second signed
# redirects; links remain usable until expiry, including after portfolio logout.
# Set password, signing secret and cloud settings in Vercel, then redeploy.
# Locally, npm run dev reads these settings from .env.local.
