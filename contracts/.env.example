# ---- Contract deployment secrets (copy to contracts/.env; NEVER commit .env) ----

# Wallet that pays for and signs the deploy transaction. Needs Base Sepolia ETH
# (grab some from a faucet). Can be a throwaway key — it only deploys.
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY

# Address that becomes the token owner / sole minter. This MUST be the backend
# admin wallet whose private key you give to the Supabase edge function. It can
# be the same as the deployer, but a separate wallet is cleaner.
ADMIN_ADDRESS=0xYOUR_BACKEND_ADMIN_WALLET_ADDRESS

# Hard supply cap in wei (18 decimals). Default = 1,000,000 tokens.
TOKEN_CAP=1000000000000000000000000

# RPC endpoints. The public Base RPCs work for testing; use Alchemy/Infura for
# production reliability.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_MAINNET_RPC_URL=https://mainnet.base.org

# Optional: BaseScan API key for `--verify` (https://basescan.org/myapikey).
BASESCAN_API_KEY=
